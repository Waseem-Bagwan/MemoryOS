# Server
# ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────
# Postgres
# Free cloud option: https://neon.tech
# Create a project → copy the connection string
# It looks like: postgresql://user:pass@host/dbname?sslmode=require
# ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/memoryos"

# ─────────────────────────────────────────
# JWT
# Any long random string — never share this
# ─────────────────────────────────────────
JWT_SECRET="replace-this-with-any-long-random-string"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────
# Redis
# Free cloud option: https://upstash.com
# Create a Redis database → copy the URL
# It looks like: rediss://default:pass@host:port
# ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────
# OpenAI
# Get from: https://platform.openai.com/api-keys
# Used by the MemoryOS decision engine
# ─────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────
# Cognee Cloud (from your dashboard screenshot)
#
# COGNEE_API_URL  → "API Base URL" field (the long AWS URL)
# COGNEE_API_KEY  → use the "MemoryOS" key you created
# COGNEE_TENANT_ID → "Tenant ID" field
# ─────────────────────────────────────────
COGNEE_API_URL="your-cognee-api-url"
COGNEE_API_KEY="your-memoryos-api-key-from-dashboard"
COGNEE_TENANT_ID="your-cognee-tenant-id"

# Frontend URL
FRONTEND_URL=http://localhost:5173